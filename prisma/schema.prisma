generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                 String        @id @default(uuid()) @db.Uuid
  nombre             String
  estado             TenantEstado  @default(pendiente)
  plan_tipo          PlanTipo?
  fecha_vencimiento  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  cierres            CierreDiario[]
  clientes           Cliente[]
  productos          Producto[]
  config             TenantConfig?
  usuarios           Usuario[]
  ventaItems         VentaItem[]
  ventas             Venta[]
  gastos             Gasto[]

  @@index([estado])
  @@map("tenants")
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("admins")
}

model TenantConfig {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @unique @db.Uuid
  logo_url        String?
  primary_color   String? @default("#5DADE2")
  secondary_color String? @default("#2C3E50")
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_configs")
}

model Usuario {
  id            Int      @id @default(autoincrement())
  tenantId      String   @db.Uuid
  nombre        String?  // nullable: vendor may not have name at invite time
  email         String   @unique
  password_hash String?  // nullable: null means "invited but not yet activated"
  rol           Rol      @default(vendedor)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ventas        Venta[]

  @@index([tenantId])
  @@map("usuarios")
}

model Cliente {
  id             Int      @id @default(autoincrement())
  tenantId       String   @db.Uuid
  nombre         String
  telefono       String?
  direccion      String?
  limite_credito Decimal  @default(0) @db.Decimal(12, 2)
  saldo_actual   Decimal  @default(0) @db.Decimal(12, 2)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ventas         Venta[]

  @@index([tenantId])
  @@index([tenantId, nombre])
  @@map("clientes")
}

model Producto {
  id           Int         @id @default(autoincrement())
  tenantId     String      @db.Uuid
  nombre       String
  sku          String
  precio_venta Decimal     @db.Decimal(12, 2)
  precio_costo Decimal     @db.Decimal(12, 2)
  stock_actual Int         @default(0)
  stock_minimo Int         @default(5)
  activo       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ventaItems   VentaItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, nombre])
  @@index([tenantId, activo])
  @@map("productos")
}

model Venta {
  id             Int           @id @default(autoincrement())
  tenantId       String        @db.Uuid
  clienteId      Int?
  usuarioId      Int
  total          Decimal       @db.Decimal(12, 2)
  estado         EstadoVenta   @default(pagado)
  metodo_pago    MetodoPago    @default(efectivo)
  fecha          DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  cierreDiarioId Int?
  items          VentaItem[]
  cierreDiario   CierreDiario? @relation(fields: [cierreDiarioId], references: [id])
  cliente        Cliente?      @relation(fields: [clienteId], references: [id])
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario        Usuario       @relation(fields: [usuarioId], references: [id])

  @@index([tenantId])
  @@index([tenantId, fecha])
  @@index([tenantId, clienteId])
  @@index([tenantId, estado])
  @@index([tenantId, cierreDiarioId])
  @@map("ventas")
}

model VentaItem {
  id              Int      @id @default(autoincrement())
  ventaId         Int
  productoId      Int
  nombre_producto String?  // Snapshot del nombre al momento de la venta
  cantidad        Int
  precio_unitario Decimal  @db.Decimal(12, 2)
  subtotal        Decimal  @db.Decimal(12, 2)
  tenantId        String?  @db.Uuid
  producto        Producto @relation(fields: [productoId], references: [id])
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venta           Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("venta_items")
}

model CierreDiario {
  id                 Int      @id @default(autoincrement())
  tenantId           String   @db.Uuid
  fecha              DateTime @default(now())
  total_vendido      Decimal  @db.Decimal(12, 2)
  productos_vendidos Json
  createdAt          DateTime @default(now())
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ventas             Venta[]

  @@index([tenantId])
  @@index([tenantId, fecha])
  @@map("cierres_diarios")
}

model Gasto {
  id          Int      @id @default(autoincrement())
  tenantId    String   @db.Uuid
  descripcion String
  monto       Decimal  @db.Decimal(12, 2)
  fecha       DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, fecha])
  @@map("gastos")
}

enum Rol {
  admin
  vendedor
}

enum EstadoVenta {
  pagado
  pendiente
  cancelado
}

enum MetodoPago {
  efectivo
  transferencia
  otro
}

enum TenantEstado {
  pendiente
  activo
  vencido
}

enum PlanTipo {
  crecimiento
  corporativo
}
